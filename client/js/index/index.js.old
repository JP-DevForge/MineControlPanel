const STORAGE_KEY = "mcp_saved_servers";

document.addEventListener("DOMContentLoaded", renderHome);

async function loadSection(group, file) {
  const ventana = document.querySelector(".ventana");
  const response = await fetch(`/sections/${group}/${file}.html`);

  if (!response.ok) {
    ventana.innerHTML = `<p class="empty-message">Error cargando ${file}</p>`;
    return false;
  }

  ventana.innerHTML = await response.text();
  return true;
}

function getServers() {
  try {
    return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
  } catch {
    return [];
  }
}

function saveServers(servers) {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(servers));
}

async function renderHome() {
  if (!await loadSection("selector", "home")) return;

  document.getElementById("open-add-server")
    .addEventListener("click", showAddServerScreen);

  document.getElementById("open-create-server")
    .addEventListener("click", showCreateServerScreen);

  renderServers();
}

function renderServers() {
  const list = document.getElementById("servers-list");
  const servers = getServers();

  if (!list) return;

  if (servers.length === 0) {
    list.innerHTML = `<div class="empty-message">No hay servidores guardados.</div>`;
    return;
  }

  list.innerHTML = servers.map(server => `
    <article class="server-item">
      <div class="server-info">
        <h3>${escapeHtml(server.name)}</h3>
        <p>${getServerDescription(server)}</p>
      </div>

      <div class="server-actions">
        <button class="boton" data-action="connect" data-id="${server.id}">
          Entrar
        </button>

        <button class="boton" data-action="delete" data-id="${server.id}">
          Eliminar
        </button>
      </div>
    </article>
  `).join("");

  list.querySelectorAll("[data-action='connect']").forEach(button => {
    button.addEventListener("click", () => connectServer(button.dataset.id));
  });

  list.querySelectorAll("[data-action='delete']").forEach(button => {
    button.addEventListener("click", () => deleteServer(button.dataset.id));
  });
}

function getServerDescription(server) {
  if (server.type === "local") {
    return `Local · ${escapeHtml(server.path)} · ${escapeHtml(server.jar)}`;
  }

  return `Remoto · ${escapeHtml(server.host)}:${server.port}`;
}

async function showAddServerScreen() {
  if (!await loadSection("selector", "addServer")) return;

  document.getElementById("back-home")
    .addEventListener("click", renderHome);

  document.getElementById("add-local-server")
    .addEventListener("click", showAddLocalServerForm);

  document.getElementById("add-remote-server")
    .addEventListener("click", showAddRemoteServerForm);
}

async function showAddLocalServerForm() {
  if (!await loadSection("selector", "addLocalServer")) return;

  document.getElementById("back-add-server")
    .addEventListener("click", showAddServerScreen);

  document.getElementById("add-local-server-form")
    .addEventListener("submit", addLocalServer);
}

async function showAddRemoteServerForm() {
  if (!await loadSection("selector", "addRemoteServer")) return;

  document.getElementById("back-add-server")
    .addEventListener("click", showAddServerScreen);

  document.getElementById("add-remote-server-form")
    .addEventListener("submit", addRemoteServer);
}

async function showCreateServerScreen() {
  if (!await loadSection("selector", "createServer")) return;

  document.getElementById("back-home")
    .addEventListener("click", renderHome);
}

function addLocalServer(event) {
  event.preventDefault();

  const servers = getServers();

  servers.push({
    id: crypto.randomUUID(),
    type: "local",
    name: document.getElementById("local-server-name").value.trim(),
    path: document.getElementById("local-server-path").value.trim(),
    jar: document.getElementById("local-server-jar").value.trim(),
    port: Number(document.getElementById("local-server-port").value),
    createdAt: new Date().toISOString()
  });

  saveServers(servers);
  renderHome();
}

function addRemoteServer(event) {
  event.preventDefault();

  const servers = getServers();

  servers.push({
    id: crypto.randomUUID(),
    type: "remote",
    name: document.getElementById("remote-server-name").value.trim(),
    protocol: document.getElementById("remote-server-protocol").value,
    host: document.getElementById("remote-server-host").value.trim(),
    port: Number(document.getElementById("remote-server-panel-port").value),
    username: document.getElementById("remote-server-user").value.trim(),
    password: document.getElementById("remote-server-password").value,
    createdAt: new Date().toISOString()
  });

  saveServers(servers);
  renderHome();
}

async function connectServer(id) {
  const server = getServers().find(item => item.id === id);

  if (!server) {
    alert("Servidor no encontrado");
    return;
  }

  if (server.type === "local") {
    sessionStorage.setItem("mcp_active_server", JSON.stringify({
      id: server.id,
      type: "local",
      name: server.name,
      baseUrl: window.location.origin
    }));

    window.location.href = "/panel";
    return;
  }

  const baseUrl = `${server.protocol}://${server.host}:${server.port}`;

  try {
    const response = await fetch(`${baseUrl}/api/login`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        username: server.username,
        password: server.password
      })
    });

    if (!response.ok) {
      throw new Error("Login incorrecto");
    }

    const data = await response.json();

    sessionStorage.setItem("mcp_active_server", JSON.stringify({
      id: server.id,
      type: "remote",
      name: server.name,
      baseUrl,
      token: data.token
    }));

    window.location.href = "/panel";
  } catch {
    alert("No se pudo conectar con el servidor remoto");
  }
}

function deleteServer(id) {
  if (!confirm("¿Eliminar este servidor?")) return;

  saveServers(getServers().filter(server => server.id !== id));
  renderServers();
}

function escapeHtml(value) {
  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}